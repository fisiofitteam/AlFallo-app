# ── Base de datos (Neon / PostgreSQL) ──────────────────────────
# Cadena pooled. En dev usa una RAMA de Neon distinta a producción.
DATABASE_URL=
# Conexión directa (sin pooler) para migraciones de Prisma. Opcional.
DIRECT_URL=

# ── Sesión / app ───────────────────────────────────────────────
# Cadena aleatoria larga. Genera con: openssl rand -base64 32
SESSION_SECRET=
APP_URL=http://localhost:3000

# Credenciales del CEO inicial que crea el seed (solo en local/seed).
SEED_CEO_EMAIL=fisiofitteam@fisiofitteam.com
SEED_CEO_PASSWORD=
SEED_CEO_NAME=Dirección

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Vercel Blob ────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Resend (email) ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Meta (Instagram + Ads) — opcional, fase tardía ─────────────
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_API_VERSION=v21.0

# ── Google Calendar — opcional ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Dev ────────────────────────────────────────────────────────
DEV_BYPASS_AUTH=false
