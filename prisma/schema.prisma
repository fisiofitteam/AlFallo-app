// Schema Prisma — Al Fallo Nutrition
// Fase 1: identidad y sesión del equipo. Se irá ampliando por fases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Miembro del equipo (dirección, nutricionistas, comercial).
// El rol se guarda como String; los valores válidos viven en src/lib/roles.ts
// para poder añadir roles sin migración.
model Professional {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String
  title        String? // cargo visible (ej. "Head Success Nutritionist")
  isActive     Boolean  @default(true)
  imageUrl     String?
  workSchedule String? // texto libre del horario para mostrar en el equipo
  notificationPrefs Json? // preferencias de notificaciones por tipo

  // Restablecer contraseña por email
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  passwordSetAt        DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions             Session[]
  clients              Client[]              @relation("NutritionistClients")
  createdPlans         NutritionPlan[]
  reviewedCheckIns     CheckIn[]             @relation("CheckInReviewer")
  payrolls             PayrollPayment[]
  leadsAsSetter        Lead[]                @relation("LeadsAsSetter")
  leadsAsCloser        Lead[]                @relation("LeadsAsCloser")
  closingShifts        ClosingShift[]        @relation("ClosingShifts")
  defaultShifts        DefaultClosingShift[]
  closedSales          Sale[]                @relation("SaleCloser")

  @@index([role])
}

// Cliente / atleta. La ficha nutricional rica vive en NutritionProfile (1-1).
model Client {
  id             String   @id @default(cuid())
  fullName       String
  email          String?  @unique
  phone          String?
  status         String   @default("pendiente_revision")
  imageUrl       String?
  nutritionistId String?
  passwordHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Onboarding y evidencia legal del contrato.
  anamnesisData        Json?
  anamnesisCompletedAt DateTime?
  contractSignedAt     DateTime?
  contractDNI          String?
  contractVersion      String?
  contractTextSnapshot String?

  nutritionist     Professional?     @relation("NutritionistClients", fields: [nutritionistId], references: [id], onDelete: SetNull)
  profile          NutritionProfile?
  plans            NutritionPlan[]
  sessions         ClientSession[]
  dailyLogs        DailyLog[]
  checkIns         CheckIn[]
  convertedLeads   Lead[]
  sales            Sale[]
  scheduledCalls   ScheduledCall[]

  @@index([nutritionistId])
  @@index([status])
}

// Check-in semanal del atleta; el nutricionista lo revisa y responde.
model CheckIn {
  id           String   @id @default(cuid())
  clientId     String
  date         DateTime @default(now())
  weightKg     Float?
  waistCm      Float?
  hipCm        Float?
  armCm        Float?
  bodyFatPct   Float?
  adherencePct Int?
  energy       Int? // 1-5
  notes        String?

  status       String    @default("pendiente") // pendiente | revisado
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewedBy Professional? @relation("CheckInReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
}

// ─── Módulo de Contenido (planificación de Instagram) ───

model WeeklyTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  days        String   @default("[]") // JSON: array de 7 objetos {dayOfWeek, title, format, goals[]}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
}

model ScriptTemplate {
  id          String   @id @default(cuid())
  name        String
  format      String // "reel" | "carousel" | "infographic" | "image" | "live"
  blocks      String   @default("[]") // JSON: [{id, label, order}]
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([format])
}

model ContentWeek {
  id        String   @id @default(cuid())
  weekNumber Int
  year      Int
  startDate DateTime // lunes
  endDate   DateTime // domingo

  // Briefing estratégico
  centralTheme           String
  bodyZone               String // pilar nutricional
  weekType               String // educativa | objeciones | lanzamiento | recuperacion
  limitingBeliefs        String  @default("[]")
  leadMagnetName         String?
  leadMagnetKeyword      String?
  commercialTrigger      String?
  previousWeekConnection String?
  nextWeekSetup          String?

  // Mix objetivo (suma 100%)
  mixValue      Int @default(50)
  mixBeliefs    Int @default(30)
  mixConversion Int @default(20)

  // KPI
  kpiName   String?
  kpiTarget Float?

  status String @default("planning") // planning | production | publishing | closed

  // Aprendizajes (al cerrar)
  closingNotes String?
  winningHooks String?
  ideasEmerged String?

  weekStories String @default("[]") // JSON array de 7 strings

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  pieces ContentPiece[]

  @@index([year, weekNumber])
  @@index([status])
}

model ContentPiece {
  id     String      @id @default(cuid())
  weekId String
  week   ContentWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 1=Lun ... 7=Dom
  format    String // reel | carousel | infographic | image | live
  title     String?
  goal      String
  goals     String  @default("[]") // JSON array
  ctaType   String
  dmKeyword String?

  hook    String?
  blocks  String  @default("[]") // JSON: [{id, label, content, order}]
  caption String?

  // Producción
  recordingLocation String?
  recordingOutfit   String?
  recordingMaterial String?
  consentSigned     Boolean @default(false)
  assignedCaseId    String?
  finalFileUrl      String?
  editorNotes       String?

  status String @default("idea") // idea | script | recorded | edited | scheduled | published

  // Métricas
  metricsReach       Int?
  metricsSaves       Int?
  metricsShares      Int?
  metricsComments    Int?
  metricsDmKeyword   Int?
  metricsConversions Int?
  metricsFilledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekId, dayOfWeek])
  @@index([status])
}

model LeadMagnet {
  id             String    @id @default(cuid())
  name           String
  keyword        String?
  description    String?
  url            String?
  active         Boolean   @default(true)
  lastPromotedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active])
}

// Caso / testimonio de transformación de un atleta (para contenido).
model ClinicalCase {
  id              String    @id @default(cuid())
  athleteName     String
  injury          String // situación / objetivo de partida
  insight         String?
  consentSigned   Boolean   @default(false)
  consentSignedAt DateTime?
  videoUrls       String    @default("[]") // JSON array de URLs
  notes           String?
  patientId       String? // cliente vinculado (opcional)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId])
}

model WinningHook {
  id          String   @id @default(cuid())
  text        String
  format      String?
  bodyZone    String?
  weekId      String?
  url         String?
  reach       Int?
  saves       Int?
  dmKeyword   Int?
  conversions Int?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([format])
  @@index([bodyZone])
}

model ContentIdea {
  id              String   @id @default(cuid())
  title           String
  description     String?
  funnelStage     String   @default("educate") // attract | educate | convert
  bodyZone        String?
  suggestedFormat String?
  used            Boolean  @default(false)
  usedPieceId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([funnelStage])
  @@index([used])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  date      DateTime
  title     String
  notes     String?
  color     String   @default("neutral") // neutral | amber | blue | emerald | purple | rose
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ─── Cuadro de mandos: movimientos, facturas y objetivos ───

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  type        String // ingreso | gasto
  category    String? // publicidad | sueldos | software | herramientas | otros | cliente | renovacion
  description String?
  amount      Float
  source      String? // stripe | manual | meta_ads | ...
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([type])
}

// Pago/factura de un miembro del equipo.
model PayrollPayment {
  id             String    @id @default(cuid())
  professionalId String
  period         String // "YYYY-MM" del mes facturado
  concept        String?
  amount         Float
  status         String    @default("pendiente") // pendiente | pagado
  invoiceUrl     String?
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([period])
  @@index([status])
}

model QuarterlyGoal {
  id           String   @id @default(cuid())
  year         Int
  quarter      Int // 1..4
  name         String
  targetAmount Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([year, quarter])
}

// ─── CRM de ventas ───

// ─── Lead: corazón del flujo comercial (landing pública + setter/closer) ───
model Lead {
  id              String   @id @default(cuid())
  fullName        String
  contactType     String // "phone" | "instagram" | "email"
  contactValue    String // ej. "+34 600 123 456" o "@usuario"
  aiSummary       String? // resumen breve auto/manual
  callScheduledAt DateTime // fecha/hora de la videoconsulta

  // status: "scheduled" | "won" | "lost" | "cancelled" | "no_show"
  status       String    @default("scheduled")
  inFollowUp   Boolean   @default(false)
  followUpNote String?
  followUpDate DateTime?

  // ─── Follow-up automático: 4 fechas + checkbox por cada una ───
  followUpStartedAt DateTime?
  followUp24hDate   DateTime?
  followUp24hDone   Boolean   @default(false)
  followUp48hDate   DateTime?
  followUp48hDone   Boolean   @default(false)
  followUp30dDate   DateTime?
  followUp30dDone   Boolean   @default(false)
  followUp90dDate   DateTime?
  followUp90dDone   Boolean   @default(false)

  setterId String?
  setter   Professional? @relation("LeadsAsSetter", fields: [setterId], references: [id], onDelete: SetNull)

  closerId String?
  closer   Professional? @relation("LeadsAsCloser", fields: [closerId], references: [id], onDelete: SetNull)

  // Conversión: cuando se gana, se vincula al Cliente creado
  convertedClientId String?
  convertedClient   Client? @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)

  lostReason String? // "precio" | "no_encaja" | "ghosting" | "otro"

  // ─── Campos rellenados por la landing pública ───
  email                String?
  phone                String?
  instagram            String?
  aiScheduled          Boolean   @default(false)
  country              String?
  motivo               String? // "¿Qué te trae aquí?"
  intentosPrevios      String? // qué ha probado antes (dietas, suplementos, coaches…)
  objetivoNutricional  String? // cómo le impacta y qué quiere conseguir (renombrado desde "impactoCrossfit")
  meetingUrl           String? // URL de Google Meet
  googleEventId        String? // id del evento en Calendar
  source               String? // "landing" | "manual" | "ads_meta" | ...
  bookedAt             DateTime?

  // ─── Etapas del flujo comercial ───
  setterNotifiedAt  DateTime? // setter avisó al closer
  closerContactedAt DateTime? // closer envió caso de éxito
  reminderSentAt    DateTime? // closer mandó recordatorio del día anterior

  sale Sale?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  decidedAt DateTime?

  @@index([status])
  @@index([callScheduledAt])
  @@index([closerId])
  @@index([inFollowUp])
}

// Llamadas post-conversión (a clientes ya activos): optimización, renovación…
// Independiente del flujo comercial. Antes de la venta, las videollamadas viven
// en Lead.callScheduledAt.
model ScheduledCall {
  id          String    @id @default(cuid())
  clientId    String
  scheduledAt DateTime
  type        String    @default("optimizacion") // "optimizacion" | "renovacion"
  notes       String?
  completedAt DateTime?
  outcome     String?
  createdAt   DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@index([clientId])
}

model Sale {
  id            String    @id @default(cuid())
  leadId        String?   @unique
  clientId      String?
  closerId      String?
  amount        Float
  currency      String    @default("EUR")
  planMonths    Int?
  startDate     DateTime  @default(now())
  endDate       DateTime?
  paymentMethod String? // manual | stripe
  notes         String?
  createdAt     DateTime  @default(now())

  lead   Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  closer Professional? @relation("SaleCloser", fields: [closerId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([startDate])
}

// Sesión de la app del atleta (cookie httpOnly propia, distinta a la del equipo).
model ClientSession {
  id        String   @id @default(cuid())
  token     String   @unique
  clientId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Registro diario del atleta: peso, sensaciones y adherencia.
model DailyLog {
  id           String   @id @default(cuid())
  clientId     String
  date         DateTime @db.Date
  weightKg     Float?
  energy       Int? // 1-5
  hunger       Int? // 1-5
  sleepHours   Float?
  adherencePct Int? // 0-100
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@index([clientId])
}

// Ficha nutricional del cliente: antropometría, deporte, restricciones y objetivo.
model NutritionProfile {
  id       String @id @default(cuid())
  clientId String @unique

  // Antropometría
  sex        String? // male | female | other
  birthDate  DateTime?
  heightCm   Int?
  weightKg   Float?
  bodyFatPct Float?
  waistCm    Float?
  hipCm      Float?
  armCm      Float?

  // Deporte
  boxName          String?
  yearsTraining    Int?
  weeklyFrequency  Int?
  level            String? // amateur | scaled | rx | competicion
  trainingSchedule String?

  // Restricciones
  allergies         String[]
  intolerances      String[]
  dislikes          String[]
  dietaryStyle      String? // omnivoro | vegetariano | vegano | ...
  supplements       String[]
  medicalConditions String?
  medication        String?

  // Objetivo
  goal          String? // perdida_grasa | recomposicion | ganancia_masa | rendimiento | definicion
  targetWeightKg Float?
  timeframe     String?

  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// Banco de alimentos reutilizable, con macros por 100 g.
model FoodLibrary {
  id            String   @id @default(cuid())
  name          String
  brand         String?
  category      String?
  imageUrl      String?
  kcalPer100    Float    @default(0)
  proteinPer100 Float    @default(0)
  carbsPer100   Float    @default(0)
  fatPer100     Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items MealItem[]

  @@index([name])
}

// Plan nutricional asignado a un cliente. Estructura: Plan -> Día -> Comida -> Item.
model NutritionPlan {
  id          String   @id @default(cuid())
  name        String
  goal        String?
  notes       String?
  clientId    String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy Professional? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  days      PlanDay[]

  @@index([clientId])
}

model PlanDay {
  id     String @id @default(cuid())
  planId String
  name   String
  order  Int    @default(0)

  plan  NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals Meal[]

  @@index([planId])
}

model Meal {
  id        String @id @default(cuid())
  planDayId String
  name      String // tipo de comida (desayuno, pre_wod, ...)
  order     Int    @default(0)

  planDay PlanDay    @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  items   MealItem[]

  @@index([planDayId])
}

// Item de una comida. Guarda una "foto" de los macros del alimento por 100 g
// para que el plan no cambie si luego se edita o borra el alimento de la biblioteca.
model MealItem {
  id            String  @id @default(cuid())
  mealId        String
  foodId        String?
  nameSnapshot  String
  quantityG     Float   @default(0)
  kcalPer100    Float   @default(0)
  proteinPer100 Float   @default(0)
  carbsPer100   Float   @default(0)
  fatPer100     Float   @default(0)
  order         Int     @default(0)

  meal Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food FoodLibrary? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([mealId])
}

// Sesión opaca: la cookie httpOnly guarda `token`; se valida en servidor.
model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  professionalId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

// ─── Agenda pública: plantilla de turnos del equipo (CEO la mantiene) ───
// Indica para cada día de la semana qué franjas cubren qué closers, con
// duración de slot en minutos. La landing /agenda usa esto como fuente de verdad.
model DefaultClosingShift {
  id                  String   @id @default(cuid())
  dayOfWeek           Int // 1=L, 2=M, ..., 7=D
  startTime           String // "HH:MM"
  endTime             String // "HH:MM"
  closerId            String
  closer              Professional @relation(fields: [closerId], references: [id])
  slotDurationMinutes Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([dayOfWeek])
  @@index([closerId])
}

// Override de semana concreta: si una semana se edita, se crea WeekOverride
// con useDefault=false + ClosingShift específicos. Si no, se usa la plantilla.
model WeekOverride {
  id            String   @id @default(cuid())
  weekStartDate DateTime @unique // lunes 00:00 UTC
  useDefault    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([weekStartDate])
}

// Franja específica de una semana (cuando hay override).
model ClosingShift {
  id                  String   @id @default(cuid())
  weekStartDate       DateTime
  dayOfWeek           Int
  startTime           String
  endTime             String
  closerId            String
  closer              Professional @relation("ClosingShifts", fields: [closerId], references: [id], onDelete: Cascade)
  notes               String?
  slotDurationMinutes Int          @default(60)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([weekStartDate, dayOfWeek])
  @@index([closerId])
}

// Bloqueos puntuales (vacaciones, festivos) que la landing descarta.
model AgendaBlock {
  id               String   @id @default(cuid())
  blockedDate      DateTime // YYYY-MM-DD a las 00:00 Madrid
  blockedStartTime String? // "HH:MM" o null (= todo el día)
  blockedEndTime   String?
  reason           String?
  createdBy        String?
  createdAt        DateTime @default(now())

  @@index([blockedDate])
}

// ─── Notificaciones in-app del equipo ───
// 1. Lead reserva en /agenda → "lead_new" para todos los SETTERS.
// 2. Setter marca "avisado" → "lead_assigned" para el CLOSER asignado.
// 3. Cron 09:00 día anterior → "call_reminder" para el CLOSER.
model TeamNotification {
  id                   String    @id @default(cuid())
  targetRole           String? // "setter" | "closer" | "ceo" | "head_success"
  targetProfessionalId String?
  type                 String // "lead_new" | "lead_assigned" | "call_reminder" | ...
  leadId               String?
  title                String
  body                 String
  actionUrl            String?
  refKey               String? // clave estable para deduplicación (cron)
  readAt               DateTime?
  createdAt            DateTime  @default(now())

  @@index([targetRole, readAt])
  @@index([targetProfessionalId, readAt])
  @@index([leadId])
  @@index([refKey])
}

// Config CMS de landings (el CEO edita el copy en runtime desde Biblioteca).
model LandingConfig {
  id        String   @id // "agenda" | "agenda_gracias" | "renewal" | "contract"
  content   String // JSON serializado
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Conexión OAuth a Google Calendar (singleton). El CEO conecta una cuenta
// (ej. videoconsultas@al-fallo.com) en Ajustes → Integraciones.
model GoogleCalendarConnection {
  id              String    @id @default(cuid())
  googleEmail     String // calendar primary
  accessTokenEnc  String // encrypted (lib/encryption)
  refreshTokenEnc String?
  tokenExpiresAt  DateTime
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
}
