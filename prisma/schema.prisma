// Schema Prisma — Al Fallo Nutrition
// Fase 1: identidad y sesión del equipo. Se irá ampliando por fases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Miembro del equipo (dirección, nutricionistas, comercial).
// El rol se guarda como String; los valores válidos viven en src/lib/roles.ts
// para poder añadir roles sin migración.
model Professional {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String
  title        String? // cargo visible (ej. "Head Success Nutritionist")
  isActive     Boolean  @default(true)
  imageUrl     String?
  workSchedule String? // texto libre del horario para mostrar en el equipo
  notificationPrefs Json? // preferencias de notificaciones por tipo

  // Restablecer contraseña por email
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  passwordSetAt        DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions             Session[]
  clients              Client[]              @relation("NutritionistClients")
  createdPlans         NutritionPlan[]
  reviewedCheckIns     CheckIn[]             @relation("CheckInReviewer")
  payrolls             PayrollPayment[]
  leadsAsSetter        Lead[]                @relation("LeadsAsSetter")
  leadsAsCloser        Lead[]                @relation("LeadsAsCloser")
  closingShifts        ClosingShift[]        @relation("ClosingShifts")
  defaultShifts        DefaultClosingShift[]
  closedSales          Sale[]                @relation("SaleCloser")

  communityFeedPosts     CommunityFeedPost[] @relation("FeedPostAuthorPro")
  communityFeedComments  CommunityComment[]  @relation("FeedCommentAuthorPro")
  communityFeedReactions CommunityReaction[] @relation("FeedReactionAuthorPro")

  weeklyTasksCreated  WeeklyTaskTemplate[]   @relation("WeeklyTaskCreator")
  weeklyTasksAssigned WeeklyTaskTemplate[]   @relation("WeeklyTaskAssignee")
  weeklyTasksDone     WeeklyTaskCompletion[]

  oneOffTasksCreated  OneOffTaskTemplate[]   @relation("OneOffTaskCreator")
  oneOffTasksAssigned OneOffTaskTemplate[]   @relation("OneOffTaskAssignee")
  oneOffTasksDone     OneOffTaskCompletion[]

  meetingsCreated Meeting[] @relation("MeetingCreator")

  recipesCreated Recipe[]        @relation("RecipeCreator")
  videosCreated  VideoResource[] @relation("VideoCreator")

  @@index([role])
}

// Cliente / atleta. La ficha nutricional rica vive en NutritionProfile (1-1).
model Client {
  id             String   @id @default(cuid())
  fullName       String
  email          String?  @unique
  phone          String?
  status         String   @default("pendiente_revision")
  imageUrl       String?
  nutritionistId String?
  passwordHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Onboarding y evidencia legal del contrato.
  anamnesisData        Json?
  anamnesisCompletedAt DateTime?
  contractSignedAt     DateTime?
  contractDNI          String?
  contractVersion      String?
  contractTextSnapshot String?

  // Reset del badge "novedades en comunidad" al entrar la última vez.
  communityLastSeenAt DateTime?

  nutritionist     Professional?     @relation("NutritionistClients", fields: [nutritionistId], references: [id], onDelete: SetNull)
  profile          NutritionProfile?
  macroTargets     MacroTargets?
  plans            NutritionPlan[]
  sessions         ClientSession[]
  dailyLogs        DailyLog[]
  checkIns         CheckIn[]
  convertedLeads   Lead[]
  sales            Sale[]
  scheduledCalls   ScheduledCall[]

  communityFeedPosts CommunityFeedPost[]        @relation("FeedPostAuthorClient")
  communityComments  CommunityComment[]         @relation("FeedCommentAuthorClient")
  communityReactions CommunityReaction[]        @relation("FeedReactionAuthorClient")
  communityProgress  CommunityLessonProgress[]

  @@index([nutritionistId])
  @@index([status])
}

// Check-in semanal del atleta; el nutricionista lo revisa y responde.
model CheckIn {
  id           String   @id @default(cuid())
  clientId     String
  date         DateTime @default(now())
  weightKg     Float?
  waistCm      Float?
  hipCm        Float?
  armCm        Float?
  bodyFatPct   Float?
  adherencePct Int?
  energy       Int? // 1-5
  notes        String?

  status       String    @default("pendiente") // pendiente | revisado
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewedBy Professional? @relation("CheckInReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
}

// ─── Módulo de Contenido (planificación de Instagram) ───

model WeeklyTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  days        String   @default("[]") // JSON: array de 7 objetos {dayOfWeek, title, format, goals[]}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
}

model ScriptTemplate {
  id          String   @id @default(cuid())
  name        String
  format      String // "reel" | "carousel" | "infographic" | "image" | "live"
  blocks      String   @default("[]") // JSON: [{id, label, order}]
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([format])
}

model ContentWeek {
  id        String   @id @default(cuid())
  weekNumber Int
  year      Int
  startDate DateTime // lunes
  endDate   DateTime // domingo

  // Briefing estratégico
  centralTheme           String
  bodyZone               String // pilar nutricional
  weekType               String // educativa | objeciones | lanzamiento | recuperacion
  limitingBeliefs        String  @default("[]")
  leadMagnetName         String?
  leadMagnetKeyword      String?
  commercialTrigger      String?
  previousWeekConnection String?
  nextWeekSetup          String?

  // Mix objetivo (suma 100%)
  mixValue      Int @default(50)
  mixBeliefs    Int @default(30)
  mixConversion Int @default(20)

  // KPI
  kpiName   String?
  kpiTarget Float?

  status String @default("planning") // planning | production | publishing | closed

  // Aprendizajes (al cerrar)
  closingNotes String?
  winningHooks String?
  ideasEmerged String?

  weekStories String @default("[]") // JSON array de 7 strings

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  pieces ContentPiece[]

  @@index([year, weekNumber])
  @@index([status])
}

model ContentPiece {
  id     String      @id @default(cuid())
  weekId String
  week   ContentWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 1=Lun ... 7=Dom
  format    String // reel | carousel | infographic | image | live
  title     String?
  goal      String
  goals     String  @default("[]") // JSON array
  ctaType   String
  dmKeyword String?

  hook    String?
  blocks  String  @default("[]") // JSON: [{id, label, content, order}]
  caption String?

  // Producción
  recordingLocation String?
  recordingOutfit   String?
  recordingMaterial String?
  consentSigned     Boolean @default(false)
  assignedCaseId    String?
  finalFileUrl      String?
  editorNotes       String?

  status String @default("idea") // idea | script | recorded | edited | scheduled | published

  // Métricas
  metricsReach       Int?
  metricsSaves       Int?
  metricsShares      Int?
  metricsComments    Int?
  metricsDmKeyword   Int?
  metricsConversions Int?
  metricsFilledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekId, dayOfWeek])
  @@index([status])
}

model LeadMagnet {
  id             String    @id @default(cuid())
  name           String
  keyword        String?
  description    String?
  url            String?
  active         Boolean   @default(true)
  lastPromotedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active])
}

// Caso / testimonio de transformación de un atleta (para contenido).
model ClinicalCase {
  id              String    @id @default(cuid())
  athleteName     String
  injury          String // situación / objetivo de partida
  insight         String?
  consentSigned   Boolean   @default(false)
  consentSignedAt DateTime?
  videoUrls       String    @default("[]") // JSON array de URLs
  notes           String?
  patientId       String? // cliente vinculado (opcional)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId])
}

model WinningHook {
  id          String   @id @default(cuid())
  text        String
  format      String?
  bodyZone    String?
  weekId      String?
  url         String?
  reach       Int?
  saves       Int?
  dmKeyword   Int?
  conversions Int?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([format])
  @@index([bodyZone])
}

model ContentIdea {
  id              String   @id @default(cuid())
  title           String
  description     String?
  funnelStage     String   @default("educate") // attract | educate | convert
  bodyZone        String?
  suggestedFormat String?
  used            Boolean  @default(false)
  usedPieceId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([funnelStage])
  @@index([used])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  date      DateTime
  title     String
  notes     String?
  color     String   @default("neutral") // neutral | amber | blue | emerald | purple | rose
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ─── Cuadro de mandos: movimientos, facturas y objetivos ───

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  type        String // ingreso | gasto
  category    String? // publicidad | sueldos | software | herramientas | otros | cliente | renovacion
  description String?
  amount      Float
  source      String? // stripe | manual | meta_ads | ...
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([type])
}

// Pago/factura de un miembro del equipo.
model PayrollPayment {
  id             String    @id @default(cuid())
  professionalId String
  period         String // "YYYY-MM" del mes facturado
  concept        String?
  amount         Float
  status         String    @default("pendiente") // pendiente | pagado
  invoiceUrl     String?
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([period])
  @@index([status])
}

model QuarterlyGoal {
  id           String   @id @default(cuid())
  year         Int
  quarter      Int // 1..4
  name         String
  targetAmount Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([year, quarter])
}

// ─── CRM de ventas ───

// ─── Lead: corazón del flujo comercial (landing pública + setter/closer) ───
model Lead {
  id              String   @id @default(cuid())
  fullName        String
  contactType     String // "phone" | "instagram" | "email"
  contactValue    String // ej. "+34 600 123 456" o "@usuario"
  aiSummary       String? // resumen breve auto/manual
  callScheduledAt DateTime // fecha/hora de la videoconsulta

  // status: "scheduled" | "won" | "lost" | "cancelled" | "no_show"
  status       String    @default("scheduled")
  inFollowUp   Boolean   @default(false)
  followUpNote String?
  followUpDate DateTime?

  // ─── Follow-up automático: 4 fechas + checkbox por cada una ───
  followUpStartedAt DateTime?
  followUp24hDate   DateTime?
  followUp24hDone   Boolean   @default(false)
  followUp48hDate   DateTime?
  followUp48hDone   Boolean   @default(false)
  followUp30dDate   DateTime?
  followUp30dDone   Boolean   @default(false)
  followUp90dDate   DateTime?
  followUp90dDone   Boolean   @default(false)

  setterId String?
  setter   Professional? @relation("LeadsAsSetter", fields: [setterId], references: [id], onDelete: SetNull)

  closerId String?
  closer   Professional? @relation("LeadsAsCloser", fields: [closerId], references: [id], onDelete: SetNull)

  // Conversión: cuando se gana, se vincula al Cliente creado
  convertedClientId String?
  convertedClient   Client? @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)

  lostReason String? // "precio" | "no_encaja" | "ghosting" | "otro"

  // ─── Campos rellenados por la landing pública ───
  email                String?
  phone                String?
  instagram            String?
  aiScheduled          Boolean   @default(false)
  country              String?
  motivo               String? // "¿Qué te trae aquí?"
  intentosPrevios      String? // qué ha probado antes (dietas, suplementos, coaches…)
  objetivoNutricional  String? // cómo le impacta y qué quiere conseguir (renombrado desde "impactoCrossfit")
  meetingUrl           String? // URL de Google Meet
  googleEventId        String? // id del evento en Calendar
  source               String? // "landing" | "manual" | "ads_meta" | ...
  bookedAt             DateTime?

  // ─── Etapas del flujo comercial ───
  setterNotifiedAt  DateTime? // setter avisó al closer
  closerContactedAt DateTime? // closer envió caso de éxito
  reminderSentAt    DateTime? // closer mandó recordatorio del día anterior

  sale Sale?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  decidedAt DateTime?

  @@index([status])
  @@index([callScheduledAt])
  @@index([closerId])
  @@index([inFollowUp])
}

// Llamadas post-conversión (a clientes ya activos): optimización, renovación…
// Independiente del flujo comercial. Antes de la venta, las videollamadas viven
// en Lead.callScheduledAt.
model ScheduledCall {
  id          String    @id @default(cuid())
  clientId    String
  scheduledAt DateTime
  type        String    @default("optimizacion") // "optimizacion" | "renovacion"
  notes       String?
  completedAt DateTime?
  outcome     String?
  createdAt   DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@index([clientId])
}

model Sale {
  id            String    @id @default(cuid())
  leadId        String?   @unique
  clientId      String?
  closerId      String?
  amount        Float
  currency      String    @default("EUR")
  planMonths    Int?
  startDate     DateTime  @default(now())
  endDate       DateTime?
  paymentMethod String? // manual | stripe
  notes         String?
  createdAt     DateTime  @default(now())

  lead   Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  closer Professional? @relation("SaleCloser", fields: [closerId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([startDate])
}

// Sesión de la app del atleta (cookie httpOnly propia, distinta a la del equipo).
model ClientSession {
  id        String   @id @default(cuid())
  token     String   @unique
  clientId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Registro diario del atleta: peso, sensaciones y adherencia.
model DailyLog {
  id           String   @id @default(cuid())
  clientId     String
  date         DateTime @db.Date
  weightKg     Float?
  energy       Int? // 1-5
  hunger       Int? // 1-5
  sleepHours   Float?
  adherencePct Int? // 0-100
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@index([clientId])
}

// Ficha nutricional del cliente: antropometría, deporte, restricciones y objetivo.
model NutritionProfile {
  id       String @id @default(cuid())
  clientId String @unique

  // Antropometría
  sex        String? // male | female | other
  birthDate  DateTime?
  heightCm   Int?
  weightKg   Float?
  bodyFatPct Float?
  waistCm    Float?
  hipCm      Float?
  armCm      Float?

  // Deporte
  boxName          String?
  yearsTraining    Int?
  weeklyFrequency  Int?
  level            String? // amateur | scaled | rx | competicion
  trainingSchedule String?

  // Restricciones
  allergies         String[]
  intolerances      String[]
  dislikes          String[]
  dietaryStyle      String? // omnivoro | vegetariano | vegano | ...
  supplements       String[]
  medicalConditions String?
  medication        String?

  // Respuestas a preguntas custom del onboarding configurable.
  // Mapeo { "extra:slug" -> valor (string | string[] | number | boolean) }.
  extraAnswers Json?

  // Objetivo
  goal          String? // perdida_grasa | recomposicion | ganancia_masa | rendimiento | definicion
  targetWeightKg Float?
  timeframe     String?

  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// Objetivos diarios de macros del cliente. Diferencia días de entreno vs
// descanso para que el plan pueda compararse contra ellos automáticamente.
model MacroTargets {
  id       String @id @default(cuid())
  clientId String @unique

  // Día de entreno (la mayoría de los días normalmente)
  kcalTraining    Float?
  proteinTraining Float?
  carbsTraining   Float?
  fatTraining     Float?

  // Día de descanso
  kcalRest    Float?
  proteinRest Float?
  carbsRest   Float?
  fatRest     Float?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// Banco de alimentos reutilizable, con macros por 100 g.
model FoodLibrary {
  id            String   @id @default(cuid())
  name          String
  brand         String?
  category      String?
  imageUrl      String?
  kcalPer100    Float    @default(0)
  proteinPer100 Float    @default(0)
  carbsPer100   Float    @default(0)
  fatPer100     Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items MealItem[]

  @@index([name])
}

// Plan nutricional asignado a un cliente. Estructura: Plan -> Día -> Comida -> Item.
model NutritionPlan {
  id          String   @id @default(cuid())
  name        String
  goal        String?
  notes       String?
  clientId    String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy Professional? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  days      PlanDay[]

  @@index([clientId])
}

model PlanDay {
  id      String @id @default(cuid())
  planId  String
  name    String
  // entreno | descanso | mixto — para comparar macros con MacroTargets
  dayType String @default("entreno")
  order   Int    @default(0)

  plan  NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals Meal[]

  @@index([planId])
}

model Meal {
  id        String @id @default(cuid())
  planDayId String
  name      String // tipo de comida (desayuno, pre_wod, ...)
  order     Int    @default(0)

  planDay PlanDay    @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  items   MealItem[]

  @@index([planDayId])
}

// Item de una comida. Guarda una "foto" de los macros del alimento por 100 g
// para que el plan no cambie si luego se edita o borra el alimento de la biblioteca.
//
// subType: agrupa items dentro de una comida (intro | grasas | carbos | proteina
//          | postre | otro). Si null, el item va sin sub-sección.
// selected: cuando hay varios items en el mismo subType (alternativas para el
//           cliente), solo los marcados cuentan para los macros del día.
model MealItem {
  id            String  @id @default(cuid())
  mealId        String
  foodId        String?
  nameSnapshot  String
  quantityG     Float   @default(0)
  kcalPer100    Float   @default(0)
  proteinPer100 Float   @default(0)
  carbsPer100   Float   @default(0)
  fatPer100     Float   @default(0)
  subType       String?
  selected      Boolean @default(true)
  order         Int     @default(0)

  meal Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food FoodLibrary? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([mealId])
}

// Sesión opaca: la cookie httpOnly guarda `token`; se valida en servidor.
model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  professionalId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

// ─── Agenda pública: plantilla de turnos del equipo (CEO la mantiene) ───
// Indica para cada día de la semana qué franjas cubren qué closers, con
// duración de slot en minutos. La landing /agenda usa esto como fuente de verdad.
model DefaultClosingShift {
  id                  String   @id @default(cuid())
  dayOfWeek           Int // 1=L, 2=M, ..., 7=D
  startTime           String // "HH:MM"
  endTime             String // "HH:MM"
  closerId            String
  closer              Professional @relation(fields: [closerId], references: [id])
  slotDurationMinutes Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([dayOfWeek])
  @@index([closerId])
}

// Override de semana concreta: si una semana se edita, se crea WeekOverride
// con useDefault=false + ClosingShift específicos. Si no, se usa la plantilla.
model WeekOverride {
  id            String   @id @default(cuid())
  weekStartDate DateTime @unique // lunes 00:00 UTC
  useDefault    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([weekStartDate])
}

// Franja específica de una semana (cuando hay override).
model ClosingShift {
  id                  String   @id @default(cuid())
  weekStartDate       DateTime
  dayOfWeek           Int
  startTime           String
  endTime             String
  closerId            String
  closer              Professional @relation("ClosingShifts", fields: [closerId], references: [id], onDelete: Cascade)
  notes               String?
  slotDurationMinutes Int          @default(60)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([weekStartDate, dayOfWeek])
  @@index([closerId])
}

// Bloqueos puntuales (vacaciones, festivos) que la landing descarta.
model AgendaBlock {
  id               String   @id @default(cuid())
  blockedDate      DateTime // YYYY-MM-DD a las 00:00 Madrid
  blockedStartTime String? // "HH:MM" o null (= todo el día)
  blockedEndTime   String?
  reason           String?
  createdBy        String?
  createdAt        DateTime @default(now())

  @@index([blockedDate])
}

// ─── Notificaciones in-app del equipo ───
// 1. Lead reserva en /agenda → "lead_new" para todos los SETTERS.
// 2. Setter marca "avisado" → "lead_assigned" para el CLOSER asignado.
// 3. Cron 09:00 día anterior → "call_reminder" para el CLOSER.
model TeamNotification {
  id                   String    @id @default(cuid())
  targetRole           String? // "setter" | "closer" | "ceo" | "head_success"
  targetProfessionalId String?
  type                 String // "lead_new" | "lead_assigned" | "call_reminder" | ...
  leadId               String?
  title                String
  body                 String
  actionUrl            String?
  refKey               String? // clave estable para deduplicación (cron)
  readAt               DateTime?
  createdAt            DateTime  @default(now())

  @@index([targetRole, readAt])
  @@index([targetProfessionalId, readAt])
  @@index([leadId])
  @@index([refKey])
}

// Config CMS de landings (el CEO edita el copy en runtime desde Biblioteca).
model LandingConfig {
  id        String   @id // "agenda" | "agenda_gracias" | "renewal" | "contract"
  content   String // JSON serializado
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Conexión OAuth a Google Calendar (singleton). El CEO conecta una cuenta
// (ej. videoconsultas@al-fallo.com) en Ajustes → Integraciones.
model GoogleCalendarConnection {
  id              String    @id @default(cuid())
  googleEmail     String // calendar primary
  accessTokenEnc  String // encrypted (lib/encryption)
  refreshTokenEnc String?
  tokenExpiresAt  DateTime
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
}

// ─── Comunidad (Classroom + Muro social) ───────────────────────────
// Dos subsistemas: cursos con lecciones y progreso por cliente, y muro
// social con autoría doble (equipo o cliente, mutuamente excluyentes).

model CommunityModule {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections CommunitySection[]

  @@index([order])
}

model CommunitySection {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module  CommunityModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons CommunityLesson[]

  @@index([moduleId, order])
}

model CommunityLesson {
  id          String   @id @default(cuid())
  sectionId   String
  title       String
  description String?
  videoUrl    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section  CommunitySection          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress CommunityLessonProgress[]

  @@index([sectionId, order])
}

// Progreso por cliente. La barra del curso = completed / total lecciones.
model CommunityLessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  clientId    String
  completedAt DateTime @default(now())

  lesson CommunityLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  client Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([lessonId, clientId])
  @@index([clientId])
}

// Post del muro. Autoría doble (uno de los dos campos, nunca ambos).
model CommunityFeedPost {
  id String @id @default(cuid())

  authorProfessionalId String?
  authorProfessional   Professional? @relation("FeedPostAuthorPro", fields: [authorProfessionalId], references: [id], onDelete: SetNull)
  authorClientId       String?
  authorClient         Client?       @relation("FeedPostAuthorClient", fields: [authorClientId], references: [id], onDelete: Cascade)

  category  String  @default("general")
  title     String?
  body      String
  imageUrl  String?
  videoUrl  String?
  pinned    Boolean @default(false)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  CommunityComment[]
  reactions CommunityReaction[]

  @@index([pinned, createdAt])
  @@index([category])
}

model CommunityComment {
  id     String @id @default(cuid())
  postId String

  professionalId String?
  professional   Professional? @relation("FeedCommentAuthorPro", fields: [professionalId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?       @relation("FeedCommentAuthorClient", fields: [clientId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  post CommunityFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// Reacción tipo "like". Único por (post, actor) → es un toggle.
model CommunityReaction {
  id     String @id @default(cuid())
  postId String

  professionalId String?
  professional   Professional? @relation("FeedReactionAuthorPro", fields: [professionalId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?       @relation("FeedReactionAuthorClient", fields: [clientId], references: [id], onDelete: Cascade)

  type      String   @default("like")
  createdAt DateTime @default(now())

  post CommunityFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, clientId])
  @@unique([postId, professionalId])
}

// Plantilla de tarea recurrente del equipo. Aparece cada semana en el panel
// principal del nutri al que se asigne (o de todos los nutris si assigneeId
// es null). Solo CEO + head_coach pueden crearlas/editarlas.
model WeeklyTaskTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?
  // 1=lunes, 2=martes, 3=miércoles, 4=jueves, 5=viernes. Sin findes.
  dayOfWeek   Int
  order       Int      @default(0)
  active      Boolean  @default(true)

  // Rol al que está dirigida la tarea. Determina en qué sección de /tareas
  // aparece y quién la ve en su panel principal. Valores: nutricionista | head_coach.
  targetRole String @default("nutricionista")

  // null = "para todos los del rol target". Si se borra el profesional
  // asignado, la tarea queda para todos en lugar de desaparecer.
  assigneeId String?
  assignee   Professional? @relation("WeeklyTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   Professional? @relation("WeeklyTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions WeeklyTaskCompletion[]

  @@index([dayOfWeek, order])
  @@index([assigneeId])
  @@index([targetRole])
}

// Marca de "hecho" por (tarea, profesional, semana). La presencia del registro
// = completada. La ausencia = pendiente. weekStart = lunes 00:00 (Europa/Madrid).
model WeeklyTaskCompletion {
  id             String   @id @default(cuid())
  templateId     String
  professionalId String
  weekStart      DateTime
  completedAt    DateTime @default(now())

  template     WeeklyTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  professional Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([templateId, professionalId, weekStart])
  @@index([professionalId, weekStart])
}

// Tarea puntual / con fecha. A diferencia de la semanal, no se reinicia cada
// lunes: depende del modo de la regla.
//
// Modos soportados:
//  - "single":          se dispara una sola vez en `date`.
//  - "range":           activa entre `startDate` y `endDate` (ambos inclusive).
//  - "monthly_weekday": cada mes el N-ésimo `weekday` (ej. primer lunes).
//                       nthWeek = 1,2,3,4 ó -1 (último). weekday = 1..7 (L..D).
//                       `until` corta la recurrencia opcionalmente.
model OneOffTaskTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?
  targetRole  String   @default("nutricionista")

  assigneeId String?
  assignee   Professional? @relation("OneOffTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  mode String

  // mode = "single"
  date DateTime?

  // mode = "range"
  startDate DateTime?
  endDate   DateTime?

  // mode = "monthly_weekday"
  nthWeek Int?
  weekday Int?

  // Hasta cuándo aplica la regla (opcional, solo recurrentes).
  until DateTime?

  active Boolean @default(true)

  createdById String?
  createdBy   Professional? @relation("OneOffTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions OneOffTaskCompletion[]

  @@index([targetRole])
  @@index([assigneeId])
}

// Marca de "hecho" de una tarea puntual. La clave de instancia es la fecha
// concreta calculada (date para single, startDate para range, el N-ésimo
// weekday del mes en curso para monthly_weekday). Se almacena como lunes-
// 00:00-Madrid-equivalente para comparar de forma estable.
model OneOffTaskCompletion {
  id             String   @id @default(cuid())
  templateId     String
  professionalId String
  instanceDate   DateTime
  completedAt    DateTime @default(now())

  template     OneOffTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  professional Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([templateId, professionalId, instanceDate])
  @@index([professionalId, instanceDate])
}

// Acta / nota de una reunión del equipo. Toda la empresa puede leer; solo
// CEO + head_coach crean y editan. La vista del feed muestra título +
// objetivo (resumen) y al expandir el body completo. Se categoriza para
// poder tener tres pestañas (ceos | nutris | otras).
model Meeting {
  id        String   @id @default(cuid())
  title     String
  // Resumen visible siempre en el feed colapsado. Lo escribe quien crea.
  objective String?
  // ceos | nutris | otras
  category  String
  // Fecha de la reunión (puede dejarse en blanco; se usa createdAt como fallback).
  date      DateTime?
  body      String   @default("")
  pinned    Boolean  @default(false)

  createdById String?
  createdBy   Professional? @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, pinned, date])
  @@index([category, createdAt])
}

// Receta reutilizable en la biblioteca. Texto libre para ingredientes y
// preparación; macros calculadas no se guardan aquí (eso lo hace el builder
// de planes con FoodLibrary).
model Recipe {
  id           String   @id @default(cuid())
  title        String
  description  String?
  // desayuno | comida | cena | snack | postre (string libre para evitar
  // migraciones cuando se añaden tipos).
  mealType     String?
  ingredients  String   @default("")
  instructions String   @default("")
  imageUrl     String?

  createdById String?
  createdBy   Professional? @relation("RecipeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mealType])
}

// Brief para el generador de planes con IA. Hay una "global" (siempre se
// inyecta) más una por cada goal del cliente (perdida_grasa, recomposicion,
// ganancia_masa, rendimiento, definicion). Al generar un plan, se concatenan
// la global + la del objetivo del cliente en el system prompt.
model AIPlanBrief {
  scope           String   @id // "global" | goal id
  philosophy      String   @default("")
  preferredFoods  String   @default("")
  avoidFoods      String   @default("")
  equivalences    String   @default("")
  additionalRules String   @default("")
  // Menús/dietas de ejemplo que la IA usa como plantilla de estilo y
  // estructura. Texto libre, puede ser un día completo o una semana.
  examplePlans    String   @default("")

  // Adjuntos en Vercel Blob (PDF/Excel/CSV) que la IA leerá al generar.
  // Equivalencias: tabla maestra de porciones/equivalencias.
  // Ejemplos: dietas reales en PDF que sirven de plantilla.
  //
  // Los campos *FileUrl/*FileName son LEGACY (1 archivo). Se mantienen
  // para no perder los adjuntos previos; al leer la config se mergean
  // automáticamente al inicio del array nuevo *Attachments.
  equivalencesFileUrl  String?
  equivalencesFileName String?
  examplePlansFileUrl  String?
  examplePlansFileName String?

  // Nuevos: arrays con N adjuntos cada uno: [{ url, name }].
  equivalencesAttachments Json?
  examplePlansAttachments Json?

  updatedAt       DateTime @updatedAt
}

// Plantilla configurable del formulario de onboarding del atleta. Singleton.
// Las secciones y campos viven como JSON para poder añadir preguntas custom
// y reordenar sin migraciones. Editable desde /biblioteca/onboarding.
model OnboardingFormConfig {
  id        String   @id @default("default")
  // [{ id, title, description?, fields: [{ id, label, type, hint?, options?, required?, hidden? }] }]
  sections  Json
  // Texto del contrato firmado por el atleta. Si es null se usa el default
  // de lib/contract.ts (CONTRACT_TEXT). El editor de biblioteca lo permite
  // sobrescribir para personalizar la cláusula.
  contractText String?
  updatedAt DateTime @updatedAt
}

// Configuración global (singleton) del calculador de macros Harris-Benedict.
// Define los factores de actividad, los ajustes por objetivo y la
// distribución de macros. Editable desde /biblioteca/macros por managers.
// Todos los campos se guardan como Json para añadir más opciones sin
// migraciones (ej. brackets nuevos de actividad).
model MacroCalcConfig {
  id                  String   @id @default("default")
  // { sedentario: {label,minFreq,maxFreq,factor}, ligero: {...}, ... }
  activityMultipliers Json
  // { perdida_grasa: {label,kcalDeltaPct}, ... }
  goalAdjustments     Json
  // { perdida_grasa: {protein,carbs,fat}, ... }  (% sobre kcal totales)
  macroDistribution   Json
  // Fórmula base. Por defecto "roza-shizgal" (HB revisada). Lo dejamos string
  // por si en el futuro queremos elegir mifflin-st-jeor u otra.
  formula             String   @default("roza-shizgal")
  updatedAt           DateTime @updatedAt
}

// Vídeo educativo / motivacional para reutilizar (YouTube, Vimeo, etc.).
// El parser de video.ts ya devuelve la URL embebible.
model VideoResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String
  // Categoría libre (ej. "técnica", "motivación", "educación nutricional").
  category    String?

  createdById String?
  createdBy   Professional? @relation("VideoCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}
